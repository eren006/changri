// ---------- helpers ----------
var $ = function(s,r){return (r||document).querySelector(s)};
var $$ = function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function hl(s,q){s=esc(s);if(!q)return s;var i=s.toLowerCase().indexOf(esc(q).toLowerCase());return i<0?s:s.slice(0,i)+"<mark>"+s.slice(i,i+q.length)+"</mark>"+s.slice(i+q.length)}
var tt;function toast(m){var t=$("#toast");t.textContent=m;t.classList.add("on");clearTimeout(tt);tt=setTimeout(function(){t.classList.remove("on")},1600)}
function copy(text){
  var done=function(){toast("已复制："+text.split("\n")[0])};
  if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(done,fallback)}else fallback();
  function fallback(){var a=document.createElement("textarea");a.value=text;a.style.position="fixed";a.style.opacity="0";document.body.appendChild(a);a.select();try{document.execCommand("copy");done()}catch(e){toast("复制失败，请手动选择")}a.remove()}
}
function store(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}}

// ---------- theme ----------
var saved=store("cr-theme");if(saved)document.documentElement.setAttribute("data-theme",saved);
$("#theme").onclick=function(){
  var cur=document.documentElement.getAttribute("data-theme")||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");
  var n=cur==="dark"?"light":"dark";document.documentElement.setAttribute("data-theme",n);store("cr-theme",n);
};

// ---------- home ----------
$("#feats").innerHTML=FEATS.map(function(f){
  return '<div class="feat"><div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">'+f[3]+'</svg></div><h3>'+f[0]+'</h3><p>'+f[1]+'</p><div class="cmds">'+f[2].map(function(c){return '<span class="chip" data-copy="'+esc(c)+'">'+esc(c)+'</span>'}).join("")+'</div></div>';
}).join("");
var demoTimer=null;
function runDemo(){
  var box=$("#demo");if(!box)return;clearTimeout(demoTimer);box.innerHTML="";
  var i=0;(function next(){
    if(i>=DEMO.length){demoTimer=setTimeout(runDemo,4200);return}
    var d=DEMO[i++],el=document.createElement("div");el.className="msg "+d[0];
    el.innerHTML=(d[0]==="bot"?'<span class="who">机器人</span>':"")+esc(d[1]);box.appendChild(el);
    requestAnimationFrame(function(){requestAnimationFrame(function(){el.classList.add("show")})});
    demoTimer=setTimeout(next,d[0]==="me"?900:1700);
  })();
}

// ---------- commands page ----------
var state={q:"",w:"all",cat:"all",v:store("cr-cmdview")==="list"?"list":"flow"};
$("#cats").innerHTML='<button class="on" data-c="all">全部 <span style="opacity:.6">'+C.length+'</span></button>'+G.map(function(g){
  var n=C.filter(function(c){return c[5]===g[0]}).length;return '<button data-c="'+g[0]+'">'+g[1]+' <span style="opacity:.6">'+n+'</span></button>'}).join("");
function whoTag(w){return w==="a"?'<span class="tag a">管理员</span>':'<span class="tag p">玩家</span>'}
function cmdCard(c,q){
  return '<div class="cmd"><div class="h"><span class="nm">'+hl(c[0],q)+'</span>'+whoTag(c[4])+'</div>'+
    (c[1]?'<div class="al">别名：'+hl(c[1],q)+'</div>':'')+
    (c[3]?'<div class="d">'+hl(c[3],q)+'</div>':'<div style="height:8px"></div>')+
    '<div class="u">'+esc(c[2])+'</div><button class="cp" data-copy="'+esc(c[2])+'">复制</button></div>';
}
function cmdHit(c,q){return !q||(c[0]+" "+c[1]+" "+c[2]+" "+c[3]).toLowerCase().indexOf(q)>=0}
// 一个玩法一块：玩家和管理员的步骤都在里面，「玩家 / 管理员」筛选只是把另一方的步骤调淡，顺序不断
function flowHit(f,q){
  if(!q)return true;
  var t=f[1]+" "+f[2]+" "+f[3]+" "+f[5]+" "+f[6].join(" ");
  f[4].forEach(function(st){t+=" "+st[1]+" "+st[2].join(" ")});
  C.forEach(function(c){if(f[6].indexOf(c[0])>=0)t+=" "+c[1]});
  return t.toLowerCase().indexOf(q)>=0;
}
function flowCard(f,q){
  var steps=f[4].map(function(st){
    var dim=state.w!=="all"&&state.w!==st[0];
    return '<li'+(dim?' class="dim"':'')+'><div class="st">'+whoTag(st[0])+hl(st[1],q)+
      '<div class="us">'+st[2].map(function(u){return '<button type="button" data-copy="'+esc(u)+'" title="点一下复制">'+hl(u,q)+'</button>'}).join("")+'</div></div></li>';
  }).join("");
  return '<div class="play"><div class="ph"><b>'+hl(f[1],q)+'</b><small>'+esc(f[2])+'</small></div><p class="pi">'+hl(f[3],q)+'</p><ol>'+steps+'</ol>'+
    (f[5]?'<p class="more">'+hl(f[5],q)+'</p>':'')+'</div>';
}
function renderFlows(){
  var q=state.q.trim().toLowerCase(),qq=state.q.trim(),html="";
  G.forEach(function(g){
    if(state.cat!=="all"&&state.cat!==g[0])return;
    var fs=F.filter(function(f){return f[0]===g[0]&&flowHit(f,q)&&(state.w==="all"||f[4].some(function(st){return st[0]===state.w}))});
    var rest=C.filter(function(c){return c[5]===g[0]&&!FCOVER[c[0]]&&(state.w==="all"||c[4]===state.w)&&cmdHit(c,q)});
    if(!fs.length&&!rest.length)return;
    html+='<div class="cgroup"><h3>'+g[1]+'<small>'+g[2]+'</small></h3>'+(g[3]?'<p>'+g[3]+'</p>':'')+
      (fs.length?'<div class="plays">'+fs.map(function(f){return flowCard(f,qq)}).join("")+'</div>':'')+
      (rest.length?(fs.length?'<p class="loose">其他指令</p>':'')+'<div class="clist">'+rest.map(function(c){return cmdCard(c,qq)}).join("")+'</div>':'')+'</div>';
  });
  $("#clist").innerHTML=html||'<div class="empty">没有找到「'+esc(state.q)+'」相关的指令。</div>';
}
function renderCmds(){
  if(state.v==="flow")return renderFlows();
  // 按指令：玩家用的和管理员用的分成两大块，每块里再按分类排
  var q=state.q.trim().toLowerCase(),html="";
  [["p","玩家用的指令","在自己的个人群、房间群里发。"],["a","管理员用的指令","要先「认管理员」；多数在后台群或公告群发。"]].forEach(function(w){
    if(state.w!=="all"&&state.w!==w[0])return;
    var part="";
    G.forEach(function(g){
      if(state.cat!=="all"&&state.cat!==g[0])return;
      var list=C.filter(function(c){return c[5]===g[0]&&c[4]===w[0]&&cmdHit(c,q)});
      if(!list.length)return;
      part+='<div class="cgroup"><h3>'+g[1]+'<small>'+g[2]+'</small></h3>'+(g[3]&&w[0]==="p"?'<p>'+g[3]+'</p>':'')+'<div class="clist">'+list.map(function(c){return cmdCard(c,state.q.trim())}).join("")+'</div></div>';
    });
    if(part)html+='<section class="cwho"><h2 class="cwho-h">'+w[1]+' <span class="tag '+w[0]+'">'+(w[0]==="p"?"玩家":"管理员")+'</span></h2><p class="note">'+w[2]+'</p>'+part+'</section>';
  });
  $("#clist").innerHTML=html||'<div class="empty">没有找到「'+esc(state.q)+'」相关的指令。</div>';
}
$$("#viewSeg button").forEach(function(x){x.classList.toggle("on",x.dataset.v===state.v)});
$("#viewSeg").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;$$("#viewSeg button").forEach(function(x){x.classList.toggle("on",x===b)});state.v=b.dataset.v;store("cr-cmdview",state.v);renderCmds()});
$("#q").addEventListener("input",function(e){state.q=e.target.value;renderCmds()});
$("#whoSeg").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;$$("#whoSeg button").forEach(function(x){x.classList.toggle("on",x===b)});state.w=b.dataset.w;renderCmds()});
$("#cats").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;$$("#cats button").forEach(function(x){x.classList.toggle("on",x===b)});state.cat=b.dataset.c;renderCmds()});
renderCmds();

// dice cards
$$("[data-dice]").forEach(function(el){
  el.innerHTML=DICE[el.dataset.dice].map(function(n){var c=C.filter(function(x){return x[0]===n&&x[5]==="dice"})[0];return c?cmdCard(c,""):""}).join("");
});
// anatomy hover
$$("#anat [data-i]").forEach(function(el){
  el.addEventListener("mouseenter",function(){$$('#anat [data-i="'+el.dataset.i+'"]').forEach(function(x){x.classList.add("on")})});
  el.addEventListener("mouseleave",function(){$$("#anat .on").forEach(function(x){x.classList.remove("on")})});
});

// ---------- role switch ----------
function setRole(r){document.body.dataset.role=r;$$("#roleSeg button").forEach(function(b){b.classList.toggle("on",b.dataset.role===r)});store("cr-role",r);buildToc()}
$("#roleSeg").addEventListener("click",function(e){var b=e.target.closest("button");if(b)setRole(b.dataset.role)});

// ---------- tabs ----------
$$("[data-tabs]").forEach(function(t){
  t.addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;var k=t.dataset.tabs;
    $$("button",t).forEach(function(x){x.classList.toggle("on",x===b)});
    $$('[data-pane^="'+k+':"]').forEach(function(p){p.classList.toggle("on",p.dataset.pane===k+":"+b.dataset.t)});
  });
});
if(/Windows/i.test(navigator.userAgent)){var wb=$('[data-tabs="os"] [data-t="win"]');wb&&wb.click()}

// ---------- copy buttons ----------
document.addEventListener("click",function(e){
  var c=e.target.closest("[data-copy]");if(c){copy(c.dataset.copy);return}
  var b=e.target.closest(".cmdline .copy");if(b){copy($("code",b.parentNode).textContent)}
});

// ---------- router + toc ----------
var current=null,spy=null;
function buildToc(){
  var page=$('.page.on');if(!page)return;var toc=$(".toc",page);if(!toc)return;
  var hs=$$("article h2[id]",page).filter(function(h){return h.offsetParent!==null});
  toc.innerHTML='<p class="t">本页目录</p>'+hs.map(function(h){return '<a href="#'+h.id+'" data-id="'+h.id+'">'+esc(h.textContent.replace(/^\d+/,""))+'</a>'}).join("");
  if(spy)spy.disconnect();
  spy=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){$$("a",toc).forEach(function(a){a.classList.toggle("on",a.dataset.id===en.target.id)})}})},{rootMargin:"-80px 0px -70% 0px"});
  hs.forEach(function(h){spy.observe(h)});
}
// ---------- 许愿池 ----------
var WISH_API="/api/wishes",wishLoaded=false;
function wishVoted(){try{return JSON.parse(localStorage.getItem("wish_up")||"[]")}catch(e){return []}}
function wishRender(ws){
  var l=$("#wl"),voted=wishVoted();
  if(!ws.length){l.innerHTML='<li class="wempty">墙上还空着，来许第一个愿吧。</li>';return}
  l.innerHTML=ws.map(function(w){var me=voted.indexOf(w.id)>=0,done=w.status==="done";
    return '<li class="w'+(done?" done":"")+'"><div class="wt">'+esc(w.text)+'<span class="wm">'+(w.name?esc(w.name)+" · ":"")+(done?'<span class="tag p">已实现</span>':"")+'</span></div>'+
      (done?'':'<button class="up" data-id="'+w.id+'"'+(me?" disabled":"")+'><b>'+w.votes+'</b>'+(me?"已想要":"我也想要")+'</button>')+'</li>'}).join("");
}
function wishLoad(){
  fetch(WISH_API,{cache:"no-store"}).then(function(r){return r.json()}).then(function(d){wishLoaded=true;wishRender(d.wishes||[])})
  .catch(function(){$("#wl").innerHTML='<li class="wempty">墙暂时打不开，过一会儿再来看。</li>'});
}
$("#wishf").addEventListener("submit",function(e){
  e.preventDefault();var b=$("#wishf button"),m=$("#wmsg");b.disabled=true;m.textContent="正在许愿……";
  fetch(WISH_API,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({text:$("#wtext").value,name:$("#wname").value})})
  .then(function(r){return r.json().then(function(d){return [r.ok,d]})})
  .then(function(x){m.textContent=x[0]?(x[1].message||"收到了。"):(x[1].error||"没许成，过一会儿再试。");if(x[0]){$("#wtext").value=""}})
  .catch(function(){m.textContent="没许成，网络好像断了，过一会儿再试。"}).then(function(){b.disabled=false});
});
$("#wl").addEventListener("click",function(e){
  var b=e.target.closest(".up");if(!b||b.disabled)return;var id=+b.dataset.id;b.disabled=true;
  fetch(WISH_API+"/"+id+"/up",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"}).then(function(r){return r.json()}).then(function(d){
    if(d.votes){b.innerHTML="<b>"+d.votes+"</b>已想要";var v=wishVoted();v.push(id);try{localStorage.setItem("wish_up",JSON.stringify(v))}catch(err){}}else{b.disabled=false}
  }).catch(function(){b.disabled=false});
});
var WST={pending:"待审核",open:"墙上",done:"已实现",rejected:"没通过"},WACT={pending:[["approve","通过"],["reject","不通过"]],open:[["done","已实现"],["reject","撤下"]],done:[["reopen","改回墙上"]],rejected:[["approve","通过"]]};
function wadmTok(){try{return sessionStorage.getItem("wish_tok")||""}catch(e){return ""}}
function wadmLoad(){
  var t=wadmTok(),m=$("#wadmmsg");if(!t)return;m.textContent="载入中……";
  fetch(WISH_API+"/admin",{headers:{Authorization:"Bearer "+t},cache:"no-store"}).then(function(r){return r.json().then(function(d){return [r.ok,d]})}).then(function(x){
    if(!x[0]){m.textContent=x[1].error||"载入失败";return}
    var ws=x[1].wishes||[];m.textContent="共 "+ws.length+" 条，待审核 "+ws.filter(function(w){return w.status==="pending"}).length+" 条";
    $("#wadm").innerHTML=ws.map(function(w){return '<li class="w"><div class="wt">'+esc(w.text)+'<span class="wm">#'+w.id+' · '+WST[w.status]+' · '+(w.name?esc(w.name)+" · ":"")+w.votes+' 人想要 · '+new Date(w.ts*1000).toLocaleString()+'</span></div><div style="display:flex;flex-direction:column;gap:6px">'+
      (WACT[w.status]||[]).concat([["delete","删除"]]).map(function(a){return '<button class="up" data-id="'+w.id+'" data-a="'+a[0]+'">'+a[1]+'</button>'}).join("")+'</div></li>'}).join("")||'<li class="wempty">还没有愿望。</li>';
  }).catch(function(){m.textContent="连不上"});
}
$("#wadmf").addEventListener("submit",function(e){e.preventDefault();try{sessionStorage.setItem("wish_tok",$("#wtok").value.trim())}catch(err){}wadmLoad()});
$("#wadm").addEventListener("click",function(e){
  var b=e.target.closest("button[data-a]");if(!b)return;if(b.dataset.a==="delete"&&!confirm("删除这个愿望？删了找不回来。"))return;b.disabled=true;
  fetch(WISH_API+"/admin/"+b.dataset.id,{method:"POST",headers:{"Content-Type":"application/json",Authorization:"Bearer "+wadmTok()},body:JSON.stringify({action:b.dataset.a})}).then(wadmLoad,wadmLoad);
});
function route(){
  var h=location.hash||"#/";
  if(h.indexOf("#/")!==0){ // in-page anchor
    var t=document.getElementById(h.slice(1));if(t){t.scrollIntoView();return}
    h="#/";
  }
  var parts=h.slice(2).split("#"),r=parts[0];
  if(r==="wishes"){r="faq";parts[1]=parts[1]||"f-wish"}   // 许愿池并进了问答页，旧链接照样能用
  if(!$('.page[data-page="'+r+'"]'))r="";
  if(r!==current){
    $$(".page").forEach(function(p){p.classList.toggle("on",p.dataset.page===r)});
    $$("#nav a").forEach(function(a){a.classList.toggle("on",a.dataset.r===r)});
    current=r;window.scrollTo(0,0);buildToc();
    if(r==="")runDemo();else clearTimeout(demoTimer);
    if(r==="faq")wishLoad();
    if(r==="wishes-admin")wadmLoad();
    document.title=(r?{install:"安装",season:"恋综指南",commands:"指令大全",dice:"跑团骰子",faq:"问答与许愿",plugins:"插件",app:"申请专属 App",how:"工作原理","wishes-admin":"许愿池审核"}[r]+" · 长日系统":"长日系统 · 把恋综装进自己的 QQ 群");
  }
  if(parts[1]){var el=document.getElementById(parts[1]);el&&setTimeout(function(){el.scrollIntoView()},30)}
  $("#drawer").classList.remove("on");
}
// toc links: keep route, scroll to anchor
document.addEventListener("click",function(e){
  var a=e.target.closest(".toc a");if(!a)return;e.preventDefault();
  var el=document.getElementById(a.dataset.id);el&&el.scrollIntoView({behavior:"smooth"});
  history.replaceState(null,"","#/"+current+"#"+a.dataset.id);
});
window.addEventListener("hashchange",route);
$("#menu").onclick=function(){$("#drawer").classList.toggle("on");this.classList.add("seen")};

// ---------- command palette ----------
var PI=[];
[["#/install","安装","Linux / Windows / 第一次使用"],["#/how","工作原理","官方机器人和 QQ 小号怎么配合"],["#/season","恋综指南","一季从头到尾"],["#/commands","指令大全","全部群指令"],["#/dice","跑团骰子","COC7 / DND5e / 绿色三角洲"],["#/plugins","插件","签到、摇汽水、自定义回复、自己写插件"],["#/faq","问答与许愿","不在线、打不开小手机…；想要什么功能，许个愿"],["#/app","申请专属 App","专属安卓 App 打包"]].forEach(function(p){PI.push({k:"页面",t:p[1],s:p[2],go:p[0]})});
$$("[data-page] article h2[id]").forEach(function(h){var pg=h.closest("[data-page]").dataset.page;PI.push({k:"章节",t:h.textContent.replace(/^\d+/,""),s:{install:"安装",season:"恋综指南",dice:"跑团骰子",plugins:"插件",faq:"问答与许愿",app:"申请 App",how:"工作原理"}[pg],go:"#/"+pg+"#"+h.id})});
C.forEach(function(c){PI.push({k:c[4]==="a"?"管理":"指令",t:c[0],s:c[2].split("\n")[0]+(c[1]?" · "+c[1]:""),cp:c[2],f:c[0]+c[1]+c[3]})});
var sel=0,res=[];
function palRender(){
  var q=$("#palq").value.trim().toLowerCase();
  res=PI.filter(function(p){return !q||(p.t+" "+p.s+" "+(p.f||"")).toLowerCase().indexOf(q)>=0}).slice(0,40);
  sel=Math.min(sel,Math.max(res.length-1,0));
  $("#pall").innerHTML=res.length?res.map(function(p,i){return '<li data-i="'+i+'" class="'+(i===sel?"on":"")+'"><span class="k">'+p.k+'</span><span class="t">'+hl(p.t,q)+'</span><span class="s">'+esc(p.s)+'</span></li>'}).join(""):'<li style="color:var(--faint)">没有结果</li>';
  var on=$("#pall li.on");on&&on.scrollIntoView({block:"nearest"});
}
function palOpen(){$("#pal").classList.add("on");$("#palq").value="";sel=0;palRender();setTimeout(function(){$("#palq").focus()},10)}
function palClose(){$("#pal").classList.remove("on")}
function palGo(i){var p=res[i];if(!p)return;palClose();if(p.cp){copy(p.cp)}else{location.hash=p.go;route()}}
$("#openPal").onclick=palOpen;
$("#pal").addEventListener("click",function(e){if(e.target.id==="pal")palClose();var li=e.target.closest("li[data-i]");if(li)palGo(+li.dataset.i)});
$("#palq").addEventListener("input",function(){sel=0;palRender()});
document.addEventListener("keydown",function(e){
  if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==="k"){e.preventDefault();$("#pal").classList.contains("on")?palClose():palOpen();return}
  if(e.key==="/"&&!/INPUT|TEXTAREA/.test(document.activeElement.tagName)){e.preventDefault();palOpen();return}
  if(!$("#pal").classList.contains("on"))return;
  if(e.key==="Escape")palClose();
  else if(e.key==="ArrowDown"){e.preventDefault();sel=Math.min(sel+1,res.length-1);palRender()}
  else if(e.key==="ArrowUp"){e.preventDefault();sel=Math.max(sel-1,0);palRender()}
  else if(e.key==="Enter"){e.preventDefault();palGo(sel)}
});

// ---------- app application form ----------
(function(){
  var f=$("#appf");if(!f)return;
  var col=$("#color");function sync(){$("#cv").textContent=col.value;$("#sw").style.background=col.value}
  col.addEventListener("input",sync);sync();
  f.addEventListener("submit",function(e){
    e.preventDefault();
    var v=function(id){return $("#"+id).value.trim()};
    $("#appmsg").textContent=["【专属 App 申请】","团的名字："+v("team"),"服务器地址："+v("host"),"主题色："+col.value,"图标："+(v("icon")||"（未填）"),"联系 QQ："+v("qq")].join("\n");
    $("#appout").hidden=false;buildToc();
    $("#appout").scrollIntoView({behavior:"smooth",block:"nearest"});
  });
  $("#appcopy").addEventListener("click",function(){copy($("#appmsg").textContent)});
})();

// ---------- 安装页红包口令：点一下才显示 ----------
$("#hbBtn").addEventListener("click",function(){var r=$("#hbReveal");r.hidden=false;this.hidden=true;this.setAttribute("aria-expanded","true")});

// ---------- 圣诞：卡片和小球上的积雪（每处厚薄不同：整片 / 几块 / 几片雪粒；带雪粒质感和亮片）+ 悬停落雪粉 ----------
(function(){
  var calm=matchMedia("(prefers-reduced-motion: reduce)").matches,hover=matchMedia("(hover: hover)").matches,uid=0;
  var COLS=["#ffffff","#fff1bf","#cfeeff","#ffd9ec","#e4dbff"];
  var MAIN=".lavcard,.phone,.feat,.season";
  var BOX=".callout,.gloss > div,.anat,.cmd,.play,details.qa,.dgcard,.rule,.arch .node,.form,.ex .chat";
  var ORB=".feat .ic,.orbic,.season .d,article h2 .n";
  var ORNAMENT=".season .d,article h2 .n";
  function rng(s){return function(){s=(s*9301+49297)%233280;return s/233280}}
  function f(n){return n.toFixed(1)}
  function mid(a,b){return f((a[0]+b[0])/2)+","+f((a[1]+b[1])/2)}
  function smooth(p){var d="M"+mid(p[p.length-1],p[0]);for(var i=0;i<p.length;i++)d+="Q"+f(p[i][0])+","+f(p[i][1])+" "+mid(p[i],p[(i+1)%p.length]);return d+"Z"}
  function pick(r,w){var x=r(),acc=0;for(var key in w){acc+=w[key];if(x<acc)return key}return key}
  function sparkles(r,n,xy,k,tw){var g="";for(var i=0;i<n;i++){var p=xy(),t=r()<tw;
    g+='<circle cx="'+f(p[0])+'" cy="'+f(p[1])+'" r="'+((.35+r()*.75)*k).toFixed(2)+'" fill="'+COLS[Math.floor(r()*COLS.length)]+'"'+(t?' class="gl" style="animation-delay:-'+(r()*3).toFixed(2)+'s"':' opacity=".8"')+'/>'}return g}
  function star(r,x,y,s){var c=f(x)+" "+f(y);
    return '<path class="gl star" style="animation-delay:-'+(r()*4).toFixed(2)+'s" fill="#fff" d="M'+f(x)+" "+f(y-s)+"Q"+c+" "+f(x+s)+" "+f(y)+"Q"+c+" "+f(x)+" "+f(y+s)+"Q"+c+" "+f(x-s)+" "+f(y)+"Q"+c+" "+f(x)+" "+f(y-s)+'Z"/>'}
  // 雪堆：底色是偏蓝的阴影，上面叠一层往上挪一点的白，露出下沿的蓝灰边；再盖一层雪粒噪点
  function pile(id,d,W,H,k,seed,extra){
    return '<svg width="'+W+'" height="'+H+'" viewBox="0 0 '+W+" "+H+'"><defs>'+
      '<linearGradient id="'+id+'g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset=".5" stop-color="#f8fafb"/><stop offset="1" stop-color="#e3ebf0"/></linearGradient>'+
      '<clipPath id="'+id+'c"><path d="'+d+'"/></clipPath>'+
      '<filter id="'+id+'f" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency="1.2" numOctaves="2" seed="'+seed+'"/><feColorMatrix values="0 0 0 0 .5  0 0 0 0 .58  0 0 0 0 .68  0 0 0 -1.8 1"/></filter>'+
      '</defs><path d="'+d+'" fill="#b9c8d4"/><g clip-path="url(#'+id+'c)">'+
      '<path d="'+d+'" fill="url(#'+id+'g)" transform="translate(0 '+(-2.4*k).toFixed(2)+')"/>'+
      '<rect width="'+W+'" height="'+H+'" filter="url(#'+id+'f)" opacity=".4"/>'+extra+'</g></svg>'}
  function flakes(r,n,xy,k){var g="";for(var i=0;i<n;i++){var p=xy();
    g+='<ellipse cx="'+f(p[0])+'" cy="'+f(p[1])+'" rx="'+f((1+r()*1.3)*k)+'" ry="'+f((.7+r()*.8)*k)+'" fill="#fbfdfe" stroke="#c3d1db" stroke-width=".4"/>'}return g}

  function buildCard(cap){
    var W=Math.round(cap.clientWidth),H=cap.clientHeight;if(W<40||!H||(cap._w===W&&cap._h===H))return;
    cap._w=W;cap._h=H;
    var k=H/26,r=rng(cap._seed),id="sn"+(++uid),drips=[],kind=cap._kind,i,x,d="",lumps=[];
    if(kind==="dust"){
      var dz=function(){return [6+r()*(W-12),(9.4+r()*2.6)*k]};
      cap.innerHTML='<svg width="'+W+'" height="'+H+'" viewBox="0 0 '+W+" "+H+'">'+flakes(r,Math.max(4,Math.round(W/26)),dz,Math.max(k,.85))+sparkles(r,Math.round(W/16),dz,Math.max(k,.85),.4)+(r()<.6?star(r,10+r()*(W-20),9*k,(2.2+r()*1.4)*Math.max(k,.85)):"")+'</svg>';
      cap._drips=[20+r()*60];return;
    }
    if(kind==="full")lumps.push([0,W]);
    else{var m=2+Math.floor(r()*3),seg=W/m;for(i=0;i<m;i++){var w=Math.min(seg-8,(.32+r()*.5)*seg+16),x0=i*seg+r()*(seg-w);lumps.push([x0,x0+w])}}
    lumps.forEach(function(L){
      var x0=L[0],x1=L[1],w=x1-x0,top=[[x0,10.5*k]],bot=[],dx=[],step=15,big=kind==="full";
      var nd=big?Math.max(1,Math.round(w/170)):(w>55&&r()<.55?1:0);
      for(i=0;i<nd;i++)dx.push(x0+(i+.2+r()*.6)*w/nd);
      // 高低起伏 = 两道缓坡叠加（大雪丘）+ 小雪包；两端 22px 内慢慢变薄
      var p1=r()*6.3,p2=r()*6.3,f1=1.2+r()*1.6,f2=2.6+r()*2.4;
      x=x0;while(true){x+=big?9+r()*16:6+r()*11;if(x>x1-(big?8:6))break;
        var u=(x-x0)/w,e=big?Math.min(1,(x-x0)/22,(x1-x)/22):Math.pow(Math.sin(Math.PI*u),.55),
            mound=big?.5+.32*Math.sin(u*f1*6.28+p1)+.18*Math.sin(u*f2*6.28+p2):1;
        top.push([x,(10.5-e*((big?1.8:2.6)+mound*(big?7.2:6.4)+r()*(big?1.8:1.4)))*k])}
      top.push([x1,10.5*k]);
      for(x=x1-step*.5;x>x0+4;x-=step){var y=(11.6+r()*1.6)*k;
        dx.forEach(function(q){var t=Math.abs(x-q);if(t<step*.55){y=(18.5+r()*5)*k;drips.push(x/W*100)}else if(t<step*1.5)y=Math.max(y,(13.6+r()*1.8)*k)});
        bot.push([x,y])}
      if(!bot.length)bot.push([(x0+x1)/2,12.2*k]);
      d+=smooth(top.concat(bot));
    });
    var g=sparkles(r,Math.round(W/(kind==="full"?6:9)),function(){var L=lumps[Math.floor(r()*lumps.length)];return [L[0]+r()*(L[1]-L[0]),(2.5+r()*10)*k]},Math.max(k,.8),.38);
    var ns=kind==="full"?Math.max(2,Math.round(W/140)):Math.min(lumps.length,1+Math.floor(r()*2));
    for(i=0;i<ns;i++){var L=lumps[i%lumps.length];g+=star(r,L[0]+(.2+r()*.6)*(L[1]-L[0]),(3.5+r()*5)*k,(2.4+r()*1.8)*Math.max(k,.8))}
    cap._drips=drips.length?drips:[(lumps[0][0]+lumps[0][1])/2/W*100];
    cap.innerHTML=pile(id,d,W,H,k,cap._seed,g);
  }

  // 小球：雪顺着球面弧线堆在顶上；挂球的顶上有金属扣，只在一侧肩上积一点
  function buildOrb(cap){
    var D=cap.parentNode.clientWidth;if(D<12||cap._w===D)return;cap._w=D;
    var P=Math.ceil(D*.3),S=D+2*P,c=S/2,R=D/2,s=D/40,r=rng(cap._seed),id="so"+(++uid),kind=cap._kind,i;
    cap.style.left=cap.style.top=(-P)+"px";cap.style.width=cap.style.height=S+"px";
    function at(deg,rad){var t=deg*Math.PI/180;return [c+rad*Math.cos(t),c+rad*Math.sin(t)]}
    if(kind==="dust"){
      var arc=function(){return at(205+r()*130,R-.5+r()*1.2)};
      cap.innerHTML='<svg width="'+S+'" height="'+S+'" viewBox="0 0 '+S+" "+S+'">'+flakes(r,3+Math.floor(r()*4),arc,Math.max(s,.6))+sparkles(r,4+Math.floor(r()*4),arc,Math.max(s,.7),.5)+'</svg>';return;
    }
    var a0,a1;
    if(kind==="full"){a0=198+r()*10;a1=332+r()*10}
    else{var left=r()<.5;a0=left?196+r()*8:290+r()*6;a1=a0+40+r()*14}
    var n=kind==="full"?11:6,out=[],inn=[],drip=Math.floor(1+r()*(n-2));
    for(i=0;i<=n;i++){var e=Math.pow(Math.sin(Math.PI*i/n),.7),deg=a0+(a1-a0)*i/n;out.push(at(deg,R+e*(2+r()*3.5)*s))}
    for(i=n;i>=0;i--){var e2=Math.pow(Math.sin(Math.PI*i/n),.8),deg2=a0+(a1-a0)*i/n,u=e2*(1.4+r()*2.2)*s;if(i===drip&&kind==="full")u=(5+r()*3)*s;inn.push(at(deg2,R-u))}
    var d=smooth(out.concat(inn)),g=sparkles(r,Math.round(D/(kind==="full"?3:5)),function(){return at(a0+r()*(a1-a0),R+(r()*3-1.5)*s)},Math.max(s,.6),.45);
    if(kind==="full"&&D>=30){var sp=at((a0+a1)/2+(r()*30-15),R+1.5*s);g+=star(r,sp[0],sp[1],(2+r()*1.2)*Math.max(s,.7))}
    cap.innerHTML=pile(id,d,S,S,Math.max(s,.5),cap._seed,g);
  }

  function dust(cap){
    if(calm||cap._busy||!cap._drips)return;cap._busy=true;setTimeout(function(){cap._busy=false},900);
    for(var k=0;k<3;k++){
      var dot=document.createElement("i"),z=(2+Math.random()*1.6).toFixed(1)+"px";dot.className="snowdust";
      dot.style.left=(cap._drips[k%cap._drips.length]+(Math.random()*4-2))+"%";
      dot.style.top=Math.round(cap.clientHeight*.62)+"px";
      dot.style.background=COLS[Math.floor(Math.random()*COLS.length)];
      dot.style.setProperty("--dx",(Math.random()*10-5).toFixed(1)+"px");
      dot.style.setProperty("--fd",(1.1+Math.random()*.6).toFixed(2)+"s");
      dot.style.animationDelay=(k*.12).toFixed(2)+"s";dot.style.width=dot.style.height=z;
      dot.addEventListener("animationend",function(){this.remove()});
      cap.appendChild(dot);
    }
  }
  function build(cap){cap._orb?buildOrb(cap):buildCard(cap)}
  var ro=window.ResizeObserver?new ResizeObserver(function(es){es.forEach(function(e){var c=e.target._snow||e.target;if(c.isConnected)build(c)})}):null;
  var n=0;
  function add(el,kind,orb){
    var cap=document.createElement("span");cap.className=orb?"snowcap snoworb":"snowcap";cap.setAttribute("aria-hidden","true");
    cap._seed=17+n*37;cap._kind=kind;cap._orb=orb;cap.style.setProperty("--sd",((n%12)*.08).toFixed(2)+"s");
    el.insertBefore(cap,el.firstChild);el._snow=cap;build(cap);
    if(ro)ro.observe(orb?el:cap);
    if(hover&&!orb)el.addEventListener("mouseenter",function(){dust(cap)});
  }
  // 每个元素只抽一次签（抽到「不积雪」的也记下），重渲染时不会变来变去
  function scan(root){
    root.querySelectorAll(MAIN+","+BOX+","+ORB).forEach(function(el){
      if(el._snowDone)return;el._snowDone=true;
      var r=rng(31+(n++)*53);r();
      if(el.matches(ORB)){var ko=el.matches(ORNAMENT)?pick(r,{none:.35,dust:.3,side:.35}):pick(r,{none:.15,dust:.25,side:.25,full:.35});if(ko!=="none")add(el,ko,true)}
      else if(el.matches(MAIN))add(el,pick(r,{full:.65,patch:.35}),false);
      else{var kb=pick(r,{none:.3,dust:.3,patch:.25,full:.15});if(kb!=="none")add(el,kb,false)}
    });
  }
  scan(document.body);
  var pend=false;
  new MutationObserver(function(ms){if(pend)return;pend=true;requestAnimationFrame(function(){pend=false;scan(document.body)})}).observe(document.body,{childList:true,subtree:true});
})();

setRole(store("cr-role")||"all");
route();
})();
</script>
</body>
</html>
