# 复制为 .env 后填写。.env 不进 git。
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx+~websockets
HOST=0.0.0.0
# 设置平台直接用「服务器公网IP:5091」就能打开（别忘了到云服务商安全组放行 5091）。
# 登录有按 IP 的逐级锁定，新装时的首次设置要验证码；但这里是 http 明文，想更稳妥可以改成 HOST=127.0.0.1 只在本机打开，
# 或用设置平台的「远程访问」页（只放行你自己的 IP）。
# 机器人和设置平台共用这一个端口；在服务器上用浏览器打开 http://127.0.0.1:5091
PORT=5091
COMMAND_START=["/",""]
LOG_LEVEL=INFO

# 机器人的 AppID / AppSecret 不用写在这里：启动后在设置平台的「机器人」页填。

# 设置平台和机器人在同一个进程里，不需要另外的 ADMIN_HOST / ADMIN_PORT。
# 可选：FLASK_SECRET_KEY=（不填会自动生成）
